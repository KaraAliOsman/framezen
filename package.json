{
  "name": "dekopen",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev -w @dekopen/server\" \"npm:dev -w @dekopen/web\"",
    "build": "npm run build -w @dekopen/web && npm run build -w @dekopen/server",
    "start": "npm run start -w @dekopen/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/engine && tsc -p packages/catalog && tsc -p packages/documents && tsc -p apps/server && tsc -p apps/web",
    "catalog:import": "tsx packages/catalog/scripts/import.ts",
    "ai:setup": "tsx scripts/ai-setup.ts",
    "ai:check": "tsx scripts/ai-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
